APP_RECORDING_FOLDER='.<wherever you want it to be>'
APP_SERVER_PORT='3600<this app does not need to be a server, though sometimes it helps to expose health endpoint>'
APP_SERVER_URL='this should be set to your production server url in prod. Can be left empty in dev'
APP_AUTO_STOP_MS='<set this if you want the app to stop automatically after a while. Very useful if it is hosted as a service which will automatically restart>'
APP_ENABLE_AI='<set to true to include an AI description; Gemini analyzes video directly>'
APP_AI_GEMINI_API_KEYS='<comma separated values - provide with your api keys from google cloud console>'
APP_AI_GEMINI_MODEL='gemini-3.8-flash'
MEGA_EMAIL='<create a mega.io account and provide with the email here>'
MEGA_PASSWORD='<create a mega.io account and provide with the password here>'
MONGO_DB_CONNECTION_STRING='<create a free mongo db using mongo atlas. e.g.: mongodb+srv://admin:<password>@freecluster.2mwhkfg.mongodb.net/?retryWrites=true&w=majority&appName=FreeCluster>'
MONGO_DB_NAME='ringnotifier'
MONGO_DB_COLLECTION_NAME='configuration'
MONGO_DB_EVENTS_COLLECTION_NAME='events'
MONGO_DB_PUSH_SUBSCRIPTIONS_COLLECTION_NAME='pushSubscriptions'
WEB_PUSH_VAPID_PUBLIC_KEY='<generate a VAPID key pair; set the public key here>'
WEB_PUSH_VAPID_PRIVATE_KEY='<keep the private key secret; set it in your server environment>'
WEB_PUSH_VAPID_SUBJECT='mailto:<your-contact-email>'
SESSION_SECRET='This can be anything, but make sure it is long and random'
